# The name Caddy serves and gets a certificate for. Its DNS A record must
# already point at this host, or issuance fails.
SITE_ADDRESS=tessera.example.com

# The client portal (optional). The name its pages show; blank is "Translation Portal".
PORTAL_DISPLAY_NAME=
# Mail from the portal is off until a host is set. With a host, a sender and the admin's
# address are required, or the portal refuses to start (issue #306).
PORTAL_SMTP_HOST=
PORTAL_SMTP_PORT=587
PORTAL_SMTP_SECURE=false
PORTAL_SMTP_USER=
PORTAL_SMTP_PASS=
PORTAL_SMTP_FROM=
PORTAL_ADMIN_EMAIL=
