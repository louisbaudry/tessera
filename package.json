{
  "name": "cat-tool",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run --exclude '**/*.gate.test.ts' --exclude '**/*.golden.test.ts'",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:gate": "vitest run gate.test",
    "test:golden": "vitest run golden.test",
    "test:all": "vitest run",
    "bench:tm": "pnpm --filter @cat-tool/db... run build && node --experimental-strip-types --disable-warning=ExperimentalWarning packages/db/src/tm/bench/run.ts",
    "cat-tool": "node packages/cli/dist/main.js"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.33.0",
    "vitest": "^3.2.0"
  }
}
