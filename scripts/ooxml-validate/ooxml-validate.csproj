<Project Sdk="Microsoft.NET.Sdk">

  <!-- A dev and CI tool, never shipped (planning/prior-art.md, kind C):
       prints the Open XML SDK validator's findings for DOCX files as JSON.
       The TypeScript test that runs it compares findings before and after
       an export (packages/db/src/project/ooxml.validate.test.ts). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
  </ItemGroup>

</Project>
