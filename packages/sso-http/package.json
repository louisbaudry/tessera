{
  "name": "@cat-tool/sso-http",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "The outbound half of single sign-on (sso-spec.md D4, D5): the code exchange and the key fetch, shared by the CAT server and the portal.",
