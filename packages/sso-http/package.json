    "typecheck": "tsc -p tsconfig.check.json"
  },
  "dependencies": {
    "@cat-tool/core": "workspace:*",
    "jose": "^6.2.13"
  },
  "devDependencies": {
    "@types/node": "^22.20.1"
  }
