// Typecheck config. Unlike tsconfig.json (which drives the build and omits
// tests from dist), this includes test files — vitest only transpiles, so
// without this a type error in a test would go unnoticed.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // The scale benchmark (src/tm/bench/) runs straight from source under
    // Node's type stripping, which needs real `.ts` import specifiers.
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts"],
  "exclude": []
}
